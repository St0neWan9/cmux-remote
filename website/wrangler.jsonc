{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cmux-remote-website",
  "account_id": "56c0f17ebb6824c44382d97f0d1f45d3",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cmux-remote.trentaml.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
